{
  "name": "derlog",
  "version": "1.23.0",
  "private": true,
  "type": "module",
  "description": "DerLog travel planner — static PWA plus optional Android shell",
  "scripts": {
    "build": "node tools/build-www.mjs",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:sign": "node tools/setup-android-release.mjs",
    "android:release": "node tools/build-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
