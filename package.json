{
  "name": "derlog",
  "version": "1.24.0",
  "private": true,
  "type": "module",
  "description": "DerLog travel planner — static PWA plus optional Android shell",
  "scripts": {
    "build": "node tools/build-www.mjs",
    "icons": "node tools/make-icons.mjs && capacitor-assets generate --android --iconBackgroundColor '#000000' --iconBackgroundColorDark '#000000' --splashBackgroundColor '#000000' --splashBackgroundColorDark '#000000'",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:sign": "node tools/setup-android-release.mjs",
    "android:release": "node tools/build-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/status-bar": "^7.0.6",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.0.0",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "^3.11.174"
  }
}
